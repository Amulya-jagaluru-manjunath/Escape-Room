# Copy this file to .env and fill in your own values. Never commit .env.

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-GEMINI_API_KEY
# Any model your key can use on the free tier (check the list in Google AI Studio).
# "gemini-flash-latest" always points at the current Flash model.
GEMINI_MODEL=gemini-flash-latest

# Set to 1 to run Version 2 without calling the API (rule parser + plain engine text).
ESCAPE_ROOM_OFFLINE=0
